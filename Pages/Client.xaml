<Page x:Class="pz6.Pages.Client"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pz6.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Client">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Приветствие пользователя -->
        <StackPanel Grid.Row="0" Margin="10" Orientation="Vertical">
            <TextBlock x:Name="txtGreeting" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="txtUserName" FontSize="14"/>
        </StackPanel>

        <!-- Остальное содержимое -->
        <Grid Grid.Row="1">
            <!-- Ваш существующий контент -->
        </Grid>
    </Grid>
</Page>